# Copier vers deploy/.env.prod et remplir. Ce fichier-ci ne contient aucun secret.
# deploy/.env.prod est ignore par git : il ne quitte jamais le serveur.

# Adresse publique. Sans domaine : un sous-domaine de l'IP en tirets + .sslip.io
# N'est lue que par la variante "Caddy dans un conteneur" (--profile caddy-conteneur).
# Avec le Caddy de l'hote, l'adresse est ecrite dans /etc/caddy/Caddyfile.
SORABEL_HOTE=sorabel.178-104-184-125.sslip.io

# PostgreSQL du conteneur. Trois mots de passe distincts, longs, generes.
SORABEL_POSTGRES_DB=sorabel
SORABEL_POSTGRES_USER=sorabel_admin
SORABEL_POSTGRES_PASSWORD=
SORABEL_SUPPORT_PASSWORD=
SORABEL_COMMERCIAL_PASSWORD=

# Generation SQL. "openai_compatible" + les trois lignes suivantes pour
# reproduire ce que le formateur a vu en demo (gpt-5.4 sur Azure AI Foundry),
# ou "deterministic" pour tourner sans aucune cle.
SORABEL_SQL_GENERATOR=deterministic
SORABEL_SQL_LLM_BASE_URL=
SORABEL_SQL_LLM_MODEL=
SORABEL_SQL_LLM_API_KEY=
SORABEL_SQL_LLM_TIMEOUT_SECONDS=90
