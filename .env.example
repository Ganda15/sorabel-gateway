# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle (docker compose expose Chroma sur 8002)
CHROMA_URL=http://localhost:8002

# Modèle d'embeddings (sentence-transformers via l'extra [vector]),
# ex. intfloat/multilingual-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Source SQLite reçue et oracle de réconciliation
SORABEL_DB=data/sorabel.db

# Runtime Text-to-SQL. En démonstration, utiliser postgres.
# Le mode auto conserve la compatibilité avec les tests fournis lorsqu'aucun
# DSN local n'est configuré.
SORABEL_SQL_BACKEND=auto
SORABEL_POSTGRES_PORT=55432
SORABEL_POSTGRES_DB=sorabel
SORABEL_POSTGRES_USER=sorabel_admin
SORABEL_POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
SORABEL_SQL_ADMIN_DSN="host=localhost port=55432 dbname=sorabel user=sorabel_admin password=REPLACE_WITH_A_LOCAL_PASSWORD"
SORABEL_SQL_SUPPORT_DSN="host=localhost port=55432 dbname=sorabel user=sorabel_support_login password=REPLACE_WITH_A_DISTINCT_LOCAL_PASSWORD"
SORABEL_SQL_COMMERCIAL_DSN="host=localhost port=55432 dbname=sorabel user=sorabel_commercial_login password=REPLACE_WITH_ANOTHER_LOCAL_PASSWORD"
SORABEL_SQL_DATABASE=sorabel
SORABEL_SQL_SQLITE_PATH=data/sorabel.db
SORABEL_SQL_STATEMENT_TIMEOUT_MS=3000
SORABEL_SQL_LOCK_TIMEOUT_MS=1000
SORABEL_SQL_MAX_ROWS=100

# Génération SQL : déterministe localement ou endpoint OpenAI-compatible.
SORABEL_SQL_GENERATOR=deterministic
SORABEL_SQL_LLM_BASE_URL=
SORABEL_SQL_LLM_MODEL=
SORABEL_SQL_LLM_API_KEY=

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/journal.jsonl

# Profil client par défaut du serveur MCP (support | commercial | developer)
SORABEL_PROFILE=support
