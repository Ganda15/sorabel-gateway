  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Arial, sans-serif",
    "primaryColor": "#e7f6f2",
    "primaryTextColor": "#17383f",
    "primaryBorderColor": "#008f83",
    "lineColor": "#31565d",
    "secondaryColor": "#fff7df",
    "tertiaryColor": "#fff0e8",
    "clusterBkg": "#f7fbfa",
    "clusterBorder": "#9ec9c2"
  },
  "flowchart": {"useMaxWidth": true, "curve": "basis", "nodeSpacing": 34, "rankSpacing": 44}
